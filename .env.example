# -----------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR
# -----------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------
# SEGURIDAD
# -----------------------------------------------
# Key que debe mandar la interfaz interna (admin.html) en el header
# 'x-api-key' para crear links de pago o anular transacciones.
# Generar una nueva por ambiente, ej: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# Dominios externos permitidos por CORS, separados por coma.
# Dejar vacío si el checkout siempre se sirve desde este mismo servidor.
ALLOWED_ORIGINS=

# Minutos que vive un link de pago antes de expirar.
ORDER_TTL_MINUTES=30

# -----------------------------------------------
# CREDENCIALES DE DATAFAST
# -----------------------------------------------
# URL base de Datafast (pruebas: https://eu-test.oppwa.com, producción: https://eu-prod.oppwa.com)
DATAFAST_URL=
DATAFAST_ENTITY_ID=
DATAFAST_BEARER_TOKEN=
DATAFAST_MID=
DATAFAST_TID=
DATAFAST_NOMBRE_COMERCIO=

# TRUE en pruebas, no incluir o dejar en FALSE en producción
# (en producción el código directamente omite el parámetro, no solo lo vacía)
DATAFAST_TEST_MODE=TRUE


# Ruta absoluta al archivo SQLite. Si se deja vacío, usa 'data/fixbtn.sqlite'
# dentro del proyecto (cómodo en local). EN PLESK: apuntar a una carpeta
# FUERA del directorio que Git despliega, para que el historial de
# transacciones y los usuarios del panel sobrevivan a cada deploy.
DB_PATH=